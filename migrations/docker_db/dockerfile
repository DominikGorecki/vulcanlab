# Postgres 16 with pgvector already installed
FROM pgvector/pgvector:pg16

# Install build deps for PostgreSQL extensions + git
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
        libreadline-dev \
        zlib1g-dev \
        flex \
        bison \
        postgresql-server-dev-16 && \
    rm -rf /var/lib/apt/lists/*

# Build and install Apache AGE for PostgreSQL 16
# Tag name comes from the official AGE PG16 release
# https://age.apache.org/release-notes/
RUN git clone --depth 1 --branch PG16/v1.5.0-rc0 https://github.com/apache/age.git /tmp/age && \
    cd /tmp/age && \
    make install && \
    rm -rf /tmp/age

# (Optional) Remove build deps to shrink image
RUN apt-get purge -y build-essential git postgresql-server-dev-16 && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*
